# ==============================================================================
# DRUGSAFE PRODUCTION DEPLOYMENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=5000

# Client Web Application URL
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL 16+)
DATABASE_URL="postgresql://postgres:postgrespassword@postgres:5432/drugsafe?schema=public"

# JWT Security Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET="drugsafe-production-access-secret-32-chars-key-change-this"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="drugsafe-production-refresh-secret-32-chars-key-change-this"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Optional Real-Time AI Provider Configuration
# Set your Google Gemini API key to enable live LLM grounded generation
GEMINI_API_KEY=""

# OCR & Prescription Scanning
OCR_PROVIDER="development"

# Storage Settings
STORAGE_PROVIDER="local"
STORAGE_BUCKET="drugsafe-prescriptions"

