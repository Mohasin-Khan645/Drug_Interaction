NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000
LOG_LEVEL=info

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/drugsafe?schema=public"

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@drugsafe.local

OCR_PROVIDER=tesseract
OCR_API_KEY=

AI_PROVIDER=null
AI_API_KEY=

STORAGE_PROVIDER=local
STORAGE_BUCKET=drugsafe-uploads
STORAGE_LOCAL_DIR=uploads

UPLOAD_MAX_BYTES=5242880
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# Development seed passwords (never use in production)
SEED_ADMIN_PASSWORD=
SEED_DOCTOR_PASSWORD=
SEED_PHARMACIST_PASSWORD=
SEED_PATIENT_PASSWORD=
