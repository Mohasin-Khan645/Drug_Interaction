# ==============================================================================
# DrugSafe Clinical Platform - Production Backend Environment Configuration
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:3000

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://postgres:postgrespassword@postgres:5432/drugsafe?schema=public"

# Cryptographic Token Secrets (Must be unique, cryptographically random, >= 32 characters)
JWT_ACCESS_SECRET="generate-a-cryptographically-secure-random-32-char-key"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="generate-a-cryptographically-secure-random-32-char-key"
REFRESH_TOKEN_EXPIRES_IN="7d"

# SMTP Alert Notifications (Optional in local, required for live clinician dispatch)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="DrugSafe Alerts <alerts@drugsafe.io>"

# Clinical OCR & Vision Service Providers (development / tesseract / aws)
OCR_PROVIDER=development
OCR_API_KEY=your_ocr_api_key

# MediSafe Clinical AI Copilot Engine Provider (development / openai / anthropic / gemini)
AI_PROVIDER=development
AI_API_KEY=your_ai_api_key

# Secure Prescription Storage Provider (local / s3)
STORAGE_PROVIDER=local
STORAGE_BUCKET=drugsafe-prescriptions
